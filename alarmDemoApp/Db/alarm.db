record(longout, "OUT_PINI:NO") {
    field(PINI, "NO")
    field(DTYP, "Python Device")
    field(OUT,  "@devsup.ptable alarm set out_pini_no")
    field(VAL,  "4")
    field(SCAN, "5 second")
}

record(waveform, "OUT_PINI:YES") {
    field(PINI, "YES")
    field(FTVL, "LONG")
    # NB, an array needs to have at least two elements. Or it is not an array.
    field(NELM, "2")
    field(DTYP, "Python Device")
    # NB, waveform does not have an OUT field.
    field(INP,  "@devsup.ptable alarm set out_pini_yes")
}

record(longin, "IN_PINI:NO") {
    field(PINI, "NO")
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm get in_pini_no")
    #field(VAL,  "6")
    field(SCAN, "I/O Intr")
}

record(longin, "IN_PINI:YES") {
    field(PINI, "YES")
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm get in_pini_yes")
    field(VAL,  "7")
    field(SCAN, "I/O Intr")
}
